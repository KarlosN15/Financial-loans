// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  adminId   Int?     // Si es AGENT, aquí guardamos el ID de su ADMIN
  admin     User?    @relation("AdminAgents", fields: [adminId], references: [id])
  agents    User[]   @relation("AdminAgents")
  clients   Client[]
  loans     Loan[]
  payments  Payment[]
  
  // Nuevas relaciones estilo Sispres
  branchId  Int?
  branch    Branch?  @relation("UserBranch", fields: [branchId], references: [id])
  
  cashRegisters CashRegister[]
  expenses      Expense[]
  investments   Investment[]
  bankAccounts  BankAccount[]
  branches      Branch[]       @relation("AdminBranches")
  routes        Route[]
  portfolios    Portfolio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             Int      @id @default(autoincrement())
  userId         Int      // Usuario dueño del cliente
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  email          String?  @unique
  identification String   // Cédula (Quitamos @unique de aquí)
  phone          String?
  loans          Loan[]
  
  routeId        Int?
  route          Route?   @relation(fields: [routeId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, identification]) // Único por administrador
}

enum LoanStatus {
  ACTIVE
  ARREARS
  COMPLETED
}

enum PaymentFrequency {
  MONTHLY
  WEEKLY
}

model Loan {
  id            Int              @id @default(autoincrement())
  userId        Int              // Usuario dueño del préstamo
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      Int
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount        Decimal          @db.Decimal(15, 2)
  interestRate  Decimal          @db.Decimal(5, 2)
  term          Int              // Número de cuotas
  frequency     PaymentFrequency @default(MONTHLY)
  status        LoanStatus       @default(ACTIVE)
  installments  Installment[]
  payments      Payment[]
  
  portfolioId   Int?
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id])
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum InstallmentStatus {
  PENDING
  PAID
}

model Installment {
  id            Int               @id @default(autoincrement())
  loanId        Int
  loan          Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  number        Int               // No. de cuota
  dueDate       DateTime
  amount        Decimal           @db.Decimal(15, 2)
  capital       Decimal           @db.Decimal(15, 2)
  interest      Decimal           @db.Decimal(15, 2)
  balance       Decimal           @db.Decimal(15, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(15, 2)
  status        InstallmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Payment {
  id            Int           @id @default(autoincrement())
  loanId        Int
  loan          Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId        Int?          
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName    String?       
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod @default(CASH)
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

// --- NUEVOS MÓDULOS SISPRES ---

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum TransactionType {
  INCOME
  EXPENSE
}

model CashRegister {
  id             Int                 @id @default(autoincrement())
  userId         Int                 // Admin
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         CashRegisterStatus  @default(OPEN)
  openingDate    DateTime            @default(now())
  closingDate    DateTime?
  openingBalance Decimal             @db.Decimal(15, 2)
  closingBalance Decimal?            @db.Decimal(15, 2)
  transactions   CashTransaction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model CashTransaction {
  id             Int             @id @default(autoincrement())
  cashRegisterId Int
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           TransactionType
  amount         Decimal         @db.Decimal(15, 2)
  description    String
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now())
}

enum ExpenseStatus {
  PAID
  PENDING
}

model Expense {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(15, 2)
  description String
  date        DateTime      @default(now())
  status      ExpenseStatus @default(PAID) 
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
}

model Investment {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  investorName String
  amount       Decimal          @db.Decimal(15, 2)
  interestRate Decimal          @db.Decimal(5, 2)
  startDate    DateTime         @default(now())
  endDate      DateTime?
  status       InvestmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model BankAccount {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  balance       Decimal           @db.Decimal(15, 2)
  transactions  BankTransaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BankTransaction {
  id            Int             @id @default(autoincrement())
  bankAccountId Int
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  description   String
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())
}

model Branch {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("AdminBranches", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  users     User[]   @relation("UserBranch")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Route {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  loans     Loan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
